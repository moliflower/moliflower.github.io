<section class="home-hero{% if page.profile.image %} home-hero--portrait{% endif %}" aria-labelledby="home-title">
  <div class="home-hero__heading">
    <h1 id="home-title">{{ page.hero_name | default: site.title | escape }}</h1>
    {% if page.hero_name %}
      <p class="home-hero__name" lang="en">
        {{ site.first_name }}
        {{ site.last_name }}
      </p>
    {% endif %}
    <p class="home-hero__subtitle">{{ page.subtitle }}</p>
  </div>

  {% if page.profile.image %}
    {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
    <div class="home-hero__portrait">
      {%
        include figure.liquid loading="eager" path=profile_image_path class="home-hero__photo" sizes="(max-width: 575px) 88px, 192px"
        alt=page.profile.image_alt cache_bust=true
      %}
    </div>
  {% endif %}

  <div class="home-hero__body">
    {{ include.bio }}
    {% if page.github_url or site.email %}
      <div class="home-hero__contact">
        {% if page.github_url %}
          <a href="{{ page.github_url | escape }}">GitHub</a>
        {% endif %}
        {% if site.email %}
          <a href="mailto:{{ site.email | escape }}">{{ site.email | escape }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>
