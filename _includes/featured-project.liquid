{% if page.featured_project %}
  <section class="featured-project scroll-animate" aria-labelledby="featured-project-title">
    <div class="featured-project__content">
      <p class="featured-project__eyebrow">FEATURED PROJECT</p>
      <h2 id="featured-project-title">{{ page.featured_project.title }}</h2>
      <p class="featured-project__description">{{ page.featured_project.description }}</p>

      {% if page.featured_project.role %}
        <p class="featured-project__role">
          <span>MY ROLE</span>
          {{ page.featured_project.role }}
        </p>
      {% endif %}

      <a class="featured-project__link" href="{{ page.featured_project.url }}" target="_blank" rel="noopener noreferrer">
        查看项目
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
      </a>
    </div>

    <div class="featured-project__visual" aria-label="TorchMorph 技术流程">
      <div class="tech-flow">
        <div class="tech-flow__node">
          <span class="tech-flow__index">01</span>
          <strong>PyTorch</strong>
          <small>Tensor Input</small>
        </div>
        <span class="tech-flow__arrow" aria-hidden="true">→</span>
        <div class="tech-flow__node tech-flow__node--accent">
          <span class="tech-flow__index">02</span>
          <strong>CUDA Kernel</strong>
          <small>Parallel Compute</small>
        </div>
        <span class="tech-flow__arrow" aria-hidden="true">→</span>
        <div class="tech-flow__node">
          <span class="tech-flow__index">03</span>
          <strong>Morphology</strong>
          <small>Batched Output</small>
        </div>
      </div>
      <div class="featured-project__stack" aria-label="技术栈">
        <span>Python</span>
        <span>PyTorch</span>
        <span>C++</span>
        <span>CUDA</span>
      </div>
    </div>
  </section>
{% endif %}
