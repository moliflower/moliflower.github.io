{% if page.showcase_items %}
  <section id="selected-work" class="home-showcase scroll-animate" aria-labelledby="home-showcase-title">
    <div class="home-showcase__header">
      <div>
        <p class="home-showcase__eyebrow">SELECTED WORK</p>
        <h2 id="home-showcase-title">精选成果</h2>
      </div>
      <div class="home-showcase__meta">
        <p class="home-showcase__intro">近期代表性的研究与工程成果。</p>
        <a class="home-showcase__all" href="{{ '/projects/' | relative_url }}">
          查看全部项目
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <div class="home-showcase__grid">
      {% for item in page.showcase_items %}
        <article class="home-showcase-card">
          <a class="home-showcase-card__link" href="{{ item.url | relative_url }}" aria-label="查看 {{ item.title }}">
            <span class="home-showcase-card__type">{{ item.type }}</span>
            <span class="home-showcase-card__number" aria-hidden="true">0{{ forloop.index }}</span>

            {% if item.visual == 'morphology' %}
              <span class="home-showcase-card__matrix" aria-hidden="true">
                <span class="home-showcase-card__matrix-grid">
                  {% for cell in (1..9) -%}
                    <i></i>
                  {%- endfor %}
                </span>
                <b>→</b>
                <span class="home-showcase-card__matrix-grid home-showcase-card__matrix-grid--output">
                  {% for cell in (1..9) -%}
                    <i></i>
                  {%- endfor %}
                </span>
              </span>
            {% endif %}

            <h3>{{ item.title }}</h3>
            <p>{{ item.description }}</p>

            {% if item.tags %}
              <ul class="home-showcase-card__tags" aria-label="技术标签">
                {% for tag in item.tags %}
                  <li>{{ tag }}</li>
                {% endfor %}
              </ul>
            {% endif %}

            <span class="home-showcase-card__action">
              查看{{ item.type }}
              <i class="home-showcase-card__arrow fa-solid fa-arrow-right" aria-hidden="true"></i>
            </span>
          </a>
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}
