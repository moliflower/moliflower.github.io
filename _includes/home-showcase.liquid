{% if page.showcase_items.size > 0 %}
  <section id="selected-work" class="home-section" aria-labelledby="home-showcase-title">
    <header class="home-section__header">
      <h2 id="home-showcase-title">项目</h2>
      <a href="{{ '/projects/' | relative_url }}">全部项目</a>
    </header>

    <ul class="home-list" role="list">
      {% for item in page.showcase_items %}
        <li class="home-list__item">
          <h3>
            <a href="{{ item.url | relative_url | escape }}">{{ item.title | escape }}</a>
          </h3>
          <p>{{ item.description }}</p>
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
