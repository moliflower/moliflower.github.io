{% if site.posts.size > 0 %}
  <section class="home-section" aria-labelledby="home-posts-title">
    <header class="home-section__header">
      <h2 id="home-posts-title">最新文章</h2>
      <a href="{{ '/blog/' | relative_url }}">全部文章</a>
    </header>
    {% assign home_posts_limit = page.latest_posts.limit | default: site.posts.size %}
    <ul class="home-list" role="list">
      {% for item in site.posts limit: home_posts_limit %}
        {% assign post_target = item.url | relative_url %}
        {% if item.redirect != blank %}
          {% if item.redirect contains '://' %}
            {% assign post_target = item.redirect %}
          {% else %}
            {% assign post_target = item.redirect | relative_url %}
          {% endif %}
        {% endif %}
        <li class="home-list__item home-list__item--dated">
          <a href="{{ post_target | escape }}">{{ item.title | escape }}</a>
          <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%Y-%m-%d' }}</time>
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
