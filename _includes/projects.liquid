{% if project.redirect %}
  {% assign project_href = project.redirect %}
{% else %}
  {% assign project_href = project.url | relative_url %}
{% endif %}

<div class="col">
  <article class="card h-100 project-card">
    {% if project.img %}
      <a class="project-card__media" href="{{ project_href }}" aria-label="查看 {{ project.title }}">
        {%
          include figure.liquid
          loading="lazy"
          path=project.img
          sizes="(min-width: 768px) 430px, 92vw"
          alt=project.title
          class="card-img-top"
        %}
      </a>
    {% endif %}
    <div class="card-body">
      <p class="project-card__eyebrow">{{ project.category | default: '项目' }}</p>
      <h3 class="card-title">
        <a href="{{ project_href }}">{{ project.title }}</a>
      </h3>
      <p class="card-text">{{ project.description }}</p>
      <div class="project-card__actions">
        <a href="{{ project_href }}">
          查看项目
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
        {% if project.github %}
          <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer" aria-label="在 GitHub 查看 {{ project.title }}">
            <i class="fa-brands fa-github" aria-hidden="true"></i>
            GitHub
            {% if project.github_stars %}
              <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                <i class="fa-solid fa-star" aria-hidden="true"></i>
                <span id="{{ project.github_stars }}-stars"></span>
              </span>
            {% endif %}
          </a>
        {% endif %}
        {% if project.docs %}
          <a href="{{ project.docs }}" target="_blank" rel="noopener noreferrer" aria-label="查看 {{ project.title }} API 文档">
            <i class="fa-solid fa-book-open" aria-hidden="true"></i>
            API 文档
          </a>
        {% endif %}
      </div>
    </div>
  </article>
</div>
