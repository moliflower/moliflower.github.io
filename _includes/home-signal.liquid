{% if page.research_interests %}
  <section class="home-signal" aria-label="研究方向">
    <p class="home-signal__label">Research interests<span>研究方向</span></p>
    <ul class="home-signal__list">
      {% for interest in page.research_interests %}
        <li>
          <span aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>{{ interest }}
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
